generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OWNER can manage users, restore backups, and change API credentials.
/// STAFF can run the day-to-day operation but not reshape the business data.
enum Role {
  OWNER
  STAFF
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         Role         @default(STAFF)
  createdAt    DateTime     @default(now())
  sessions     Session[]
  laborEntries LaborEntry[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

enum PalletStatus {
  /// Watching the auction; no money committed yet.
  BIDDING
  /// Auction won, not yet collected.
  WON
  RECEIVED
  IN_PROCESSING
  PARTIALLY_LISTED
  FULLY_LISTED
  CLOSED
}

enum ProductCategory {
  POWER_TOOLS
  HAND_TOOLS
  HARDWARE
  ELECTRICAL_LIGHTING
  PLUMBING
  GENERAL_HOME
  APPLIANCES
  MIXED
}

/// How the seller graded the lot. The single strongest predictor of dud rate,
/// so it is the axis the aggregate view groups profit-per-hour by.
enum ConditionGrade {
  NEW
  SHELF_PULL
  OVERSTOCK
  CUSTOMER_RETURNS
  SALVAGE
  MIXED
}

/// A lot bought at auction: the unit of purchase, and the unit P&L lives at.
///
/// Cost stays here and is never allocated down to individual units — manifest
/// retail is demonstrably unreliable, so any per-unit split would be fiction.
/// See lib/lotPerformanceMath.ts.
model Pallet {
  id                      String          @id @default(cuid())
  palletCode              String          @unique // PAL-2026-001
  supplier                String // Liquidation.com / B-Stock / Other
  /// The seller's own manifest or auction id, for matching back to their site.
  sourceLotId             String?
  purchaseDate            DateTime
  /// All-in cost: hammer price plus buyer's premium, tax and any other fees.
  /// Every existing screen reads this, so it stays the authoritative total;
  /// `fees` is the breakdown, and the purchase price is totalCost − fees.
  totalCost               Decimal         @db.Decimal(12, 2)
  /// Buyer's premium, tax, and anything else on top of the hammer price.
  fees                    Decimal         @default(0) @db.Decimal(12, 2)
  manifestUrl             String?
  category                ProductCategory @default(MIXED)
  conditionGrade          ConditionGrade  @default(MIXED)
  /// Units the manifest promised vs units that actually turned up. They differ.
  manifestUnitCount       Int?
  actualUnitCount         Int?
  /// Sum of the manifest's retail column. Context only — explicitly NOT a
  /// valuation, and never used to price or allocate anything.
  manifestRetailTotal     Decimal?        @db.Decimal(12, 2)
  /// What we predicted we would recover, recorded BEFORE bidding. Drives the
  /// estimate-accuracy metric that calibrates our max bids.
  preBidEstimatedRecovery Decimal?        @db.Decimal(12, 2)
  /// When the lot physically arrived. The clock every timing metric runs from.
  pickupDate              DateTime?
  status                  PalletStatus    @default(RECEIVED)
  notes                   String?
  items                   Item[]
  labor                   LaborEntry[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

/// What kind of work an hour went into.
enum LaborActivity {
  PICKUP_TRANSPORT
  TESTING_SORTING
  PHOTOGRAPHING_LISTING
  PACKING_SHIPPING
  OTHER
}

/// One work session against one lot. The missing input for every labor-derived
/// metric — without these rows profit-per-hour cannot be computed at all.
model LaborEntry {
  id        String        @id @default(cuid())
  palletId  String
  pallet    Pallet        @relation(fields: [palletId], references: [id], onDelete: Cascade)
  /// Who did the work. Nulled if the account is deleted; userName survives so
  /// the history stays attributable.
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  date      DateTime
  hours     Decimal       @db.Decimal(6, 2)
  activity  LaborActivity @default(TESTING_SORTING)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([palletId])
  @@index([userId])
  @@index([date])
}

/// Whether a unit is stock we can count on or a gamble.
/// Floor units (copper, panels, smoke detectors, brand-name cordless) are what
/// we should actually bid against; speculative units are upside, not budget.
enum ValueClass {
  FLOOR
  SPECULATIVE
}

/// Why a unit is worth nothing. Calibrates the attrition assumption in bidding.
enum DudReason {
  NON_FUNCTIONAL
  MISSING_PARTS
  MISSING_BATTERY
  DAMAGED
  NOT_AS_MANIFESTED
  OTHER
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ItemStatus {
  IN_STOCK
  LISTED
  /// Promised to a buyer (local pickup, pending payment) — off the market but
  /// not yet sold, so it can't be double-sold while it waits.
  RESERVED
  SOLD
  RETURNED
  SCRAPPED
}

/// Where a sold order is in the pick → pack → ship pipeline.
enum OrderStatus {
  AWAITING_PICK
  PICKED
  PACKED
  SHIPPED
  CANCELLED
}

enum LotStatus {
  DRAFT
  LISTED
  SOLD
  CANCELLED
}

enum CountStatus {
  OPEN
  CLOSED
}

enum Platform {
  EBAY
  AMAZON
  FACEBOOK
  OTHER
}

/// Where a unit is advertised. Separate from Platform, which records where a
/// sale eventually happened.
enum ListingChannel {
  EBAY
  AMAZON
  FACEBOOK
  OTHER
}

/// How a listing came down, so the takedown queue can tell "we ended it" from
/// "it sold here" from "someone still has to go and do it".
enum ListingEndReason {
  /// Ended through the channel's API.
  AUTO
  /// Staff confirmed they pulled it down by hand.
  MANUAL
  /// This is the channel the sale came through.
  SOLD_HERE
  /// Unit was scrapped or the listing was withdrawn before any sale.
  WITHDRAWN
}

model Item {
  id              String          @id @default(cuid())
  sku             String          @unique // ITM-PAL001-001
  palletId        String
  pallet          Pallet          @relation(fields: [palletId], references: [id], onDelete: Cascade)
  upc             String?
  name            String
  brand           String?
  category        ProductCategory @default(MIXED)
  condition       ItemCondition   @default(GOOD)
  conditionNotes  String?
  msrp            Decimal?        @db.Decimal(12, 2)
  ourCost         Decimal         @default(0) @db.Decimal(12, 2)
  sellPrice       Decimal?        @db.Decimal(12, 2)
  soldPrice       Decimal?        @db.Decimal(12, 2)
  feesAmount      Decimal?        @db.Decimal(12, 2) // platform fees on the sale
  shippingCost    Decimal?        @db.Decimal(12, 2) // what we paid to ship
  photos          String[]        @default([])
  serialNumber    String?
  weightLbs       Decimal?        @db.Decimal(8, 2)
  lengthIn        Decimal?        @db.Decimal(8, 2)
  widthIn         Decimal?        @db.Decimal(8, 2)
  heightIn        Decimal?        @db.Decimal(8, 2)
  storageLocation String?
  status          ItemStatus      @default(IN_STOCK)
  platform        Platform?
  listingUrl      String?
  listingIdEbay   String?
  listingIdAmazon String?
  dateListed      DateTime?
  dateSold        DateTime?
  dateReturned    DateTime?
  returnReason    String?
  /// Marketplace order number as reported by eBay/Amazon (free text).
  orderId         String?
  /// The fulfillment record this item ships on.
  orderRecordId   String?
  orderRecord     Order?          @relation(fields: [orderRecordId], references: [id], onDelete: SetNull)
  listings        Listing[]
  /// Set when the item has been folded into a multi-item lot listing.
  lotId           String?
  lot             Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  orderLines      OrderLine[]
  /// Local-buyer hold: who it is held for and until when.
  /// Reliable seller or a gamble. Tagged by hand at intake; null until judged.
  valueClass      ValueClass?
  /// Arrived dead. Excluded from sell-through denominators, counted in dud rate.
  isDud           Boolean         @default(false)
  dudReason       DudReason?
  /// Local-buyer hold: who it is held for and until when.
  reservedFor     String?
  reservedUntil   DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([palletId])
  @@index([status])
  @@index([isDud])
  @@index([upc])
  @@index([storageLocation])
  @@index([orderRecordId])
  @@index([lotId])
}

/// A buyer's order: the unit of work for picking, packing, and shipping.
/// One order can carry several items.
model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // internal, e.g. ORD-2026-001
  /// Marketplace order id. Unique so a concurrent sync cannot create two
  /// orders for the same marketplace order.
  externalId     String?     @unique
  platform       Platform?
  buyerName      String?
  shipToName     String?
  shipToLine1    String?
  shipToLine2    String?
  shipToCity     String?
  shipToState    String?
  shipToPostal   String?
  shipToCountry  String?
  status         OrderStatus @default(AWAITING_PICK)
  soldAt         DateTime?
  /// Ship-by deadline; drives the "late" flag on the fulfillment queue.
  shipByDate     DateTime?
  pickedAt       DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  carrier        String?
  trackingNumber String?
  /// What the buyer paid for shipping vs what it actually cost us.
  shippingPaid   Decimal?    @db.Decimal(12, 2)
  shippingCost   Decimal?    @db.Decimal(12, 2)
  notes          String?
  items          Item[]
  lines          OrderLine[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
}

/// What actually went in the box, recorded per unit at the moment of sale.
///
/// Item.orderRecordId only ever points at the order that holds a unit RIGHT
/// NOW, so it moves the instant a returned unit is resold — taking the line
/// off the original order with it, and rewriting what a shipped order says it
/// contained. A packing slip has to keep saying what was shipped.
///
/// Lines are editable while the order is open (a wrongly-added unit is a
/// mistake, not history) and frozen once it ships. Price and name are copied,
/// not joined, so a later re-price or rename cannot rewrite a past shipment.
model OrderLine {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Kept as SetNull rather than Cascade: deleting a unit from inventory must
  /// not silently delete the line saying we shipped it to someone.
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku        String
  name       String
  soldPrice  Decimal? @db.Decimal(12, 2)
  feesAmount Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([orderId, itemId])
  @@index([itemId])
}

/// Several slow-moving items sold together as one listing.
model Lot {
  id          String    @id @default(cuid())
  lotCode     String    @unique // LOT-2026-001
  name        String
  description String?
  askingPrice Decimal?  @db.Decimal(12, 2)
  status      LotStatus @default(DRAFT)
  platform    Platform?
  soldPrice   Decimal?  @db.Decimal(12, 2)
  dateListed  DateTime?
  dateSold    DateTime?
  notes       String?
  items       Item[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

/// A stock-take of one storage location: scan what's on the shelf, then
/// reconcile against what the system believes should be there.
model CountSession {
  id        String      @id @default(cuid())
  location  String
  status    CountStatus @default(OPEN)
  startedBy String
  startedAt DateTime    @default(now())
  closedAt  DateTime?
  notes     String?
  scans     CountScan[]

  @@index([location])
  @@index([status])
}

model CountScan {
  id        String       @id @default(cuid())
  sessionId String
  session   CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sku       String
  /// Null when the scanned code matches no known item.
  itemId    String?
  scannedAt DateTime     @default(now())

  @@unique([sessionId, sku])
  @@index([sessionId])
}

/// A saved inventory filter — a personal work queue ("my photo backlog").
model SavedView {
  id        String   @id @default(cuid())
  name      String
  /// The inventory querystring, e.g. "status=IN_STOCK&category=POWER_TOOLS".
  query     String
  /// Null means the view is shared with the whole team.
  userId    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String // shipping supplies / storage / platform fees / other
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model SupplierPurchase {
  id            String   @id @default(cuid())
  supplierName  String
  purchaseDate  DateTime
  manifestId    String?
  category      String?
  palletsBought Int      @default(1)
  totalPaid     Decimal  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
}

// Key-value app settings: defaultPricePct, agingDays, API credentials, etc.
model Setting {
  key   String @id
  value String
}

model ListingTemplate {
  id                  String          @id @default(cuid())
  category            ProductCategory @unique
  titleTemplate       String // e.g. "{brand} {name} - {condition}"
  descriptionTemplate String
}

model StorageLocation {
  code  String  @id // e.g. SHELF-A3
  notes String?
}

// Team audit trail: who did what, when.
model ActivityLog {
  id        String   @id @default(cuid())
  userName  String
  action    String // e.g. item.create, item.sold, pallet.import
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One advertisement of one unit on one channel.
///
/// A unit can be live on eBay, Amazon and Facebook Marketplace at once, and
/// nothing used to record that. When it sold on one, the others stayed up: the
/// next buyer purchased stock that no longer existed, which costs a refund, the
/// postage, and a defect on the seller account. This table is what makes
/// "where else is this advertised?" an answerable question.
///
/// One row per unit per channel, reused when a unit is relisted — the history
/// that matters is on the sale, not on the advert.
model Listing {
  id              String            @id @default(cuid())
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel         ListingChannel
  /// eBay ItemID, Amazon seller SKU. Null on Facebook, which has no id we can
  /// capture from a text block someone pasted into a browser.
  externalId      String?
  url             String?
  price           Decimal?          @db.Decimal(12, 2)
  listedAt        DateTime          @default(now())
  /// Null means still live and still sellable to someone.
  endedAt         DateTime?
  endReason       ListingEndReason?
  /// Set when the unit sold elsewhere and this advert must come down.
  needsTakedownAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([itemId, channel])
  @@index([endedAt])
  @@index([needsTakedownAt])
}
