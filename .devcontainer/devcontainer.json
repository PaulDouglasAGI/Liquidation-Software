{
  "name": "Liquidation Ops",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Runs once when the Codespace is created: installs deps and sets up the DB.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Runs every time you (re)connect: starts the dev server in a visible terminal.
  "postAttachCommand": "bash .devcontainer/start.sh",
  // Without this the UI attaches — and postAttachCommand fires — while
  // postCreateCommand is still installing. The dev server then reads
  // node_modules mid-install, npm's cleanup fails with ENOTEMPTY, and the
  // install aborts half-built. Default is "updateContentCommand".
  "waitFor": "postCreateCommand",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Liquidation Ops",
      // Opens a real browser tab, NOT VS Code's built-in preview. The preview
      // renders the app in a cross-site iframe, where the SameSite=Lax session
      // cookie is never sent back — you would sign in and be bounced straight
      // to /login again. A normal tab is first-party, so auth works.
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  "remoteUser": "node"
}
