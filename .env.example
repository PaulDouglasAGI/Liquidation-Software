# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liquidation

# Random string used to sign session tokens
SESSION_SECRET=change-me-to-a-long-random-string

# eBay API credentials (https://developer.ebay.com)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_AUTH_TOKEN=
# SANDBOX or PRODUCTION
EBAY_ENV=PRODUCTION

# Amazon SP-API credentials
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# upcitemdb.com API key (optional - trial endpoint works without one)
UPC_API_KEY=

# Where item photos are stored on disk
LOCAL_UPLOAD_PATH=./uploads

# Initial admin user created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=admin123
# Set to 1 to also seed demo pallets/items for trying the app out
SEED_DEMO=0
