# --- Required ----------------------------------------------------------------
# PostgreSQL connection string (the only required setting)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liquidation

# --- Optional -----------------------------------------------------------------
# Where item photos are stored on disk (default: ./uploads)
LOCAL_UPLOAD_PATH=./uploads

# eBay API credentials — can also be entered in the app under Settings.
# For "Connect eBay" (OAuth): set APP_ID, CERT_ID, DEV_ID, and RU_NAME, then
# click Connect in Settings. AUTH_TOKEN is the legacy manual alternative.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_RU_NAME=
EBAY_AUTH_TOKEN=
EBAY_REFRESH_TOKEN=
# SANDBOX or PRODUCTION
EBAY_ENV=PRODUCTION

# Amazon SP-API credentials — can also be entered in the app under Settings
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# upcitemdb.com API key (trial endpoint works without one)
UPC_API_KEY=

# Required to enable POST /api/webhooks/ebay (sent as X-Webhook-Secret header).
# The webhook stays disabled while this is empty.
WEBHOOK_SECRET=

# Dev conveniences for `npm run db:seed`:
# seed an admin user (the normal path is the in-app setup wizard at /setup)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# set to 1 to seed demo pallets/items for trying the app out
SEED_DEMO=0
